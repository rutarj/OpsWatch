# Copy to .env and fill in. Never commit .env.
OPSWATCH_API_KEY=change-me-to-a-long-random-string
# Optional: enables the llm and hybrid triagers and the LLM eval
ANTHROPIC_API_KEY=
OPSWATCH_TRIAGER=rules          # rules | ml | llm | hybrid
OPSWATCH_MODEL=claude-haiku-4-5-20251001
OPSWATCH_REVIEW_THRESHOLD=0.6
OPSWATCH_SNS_VERIFY=true        # keep true anywhere reachable from the internet
